# Modello di keystore.properties (root del repo Wear, gitignorato).
# Copialo in keystore.properties con i valori veri per firmare la release
# Play; senza quel file `assembleRelease` produce un APK non firmato.
# storeFile è relativo alla root del repo (o un percorso assoluto).
storeFile=release-upload.jks
storePassword=CAMBIAMI
keyAlias=upload
keyPassword=CAMBIAMI
